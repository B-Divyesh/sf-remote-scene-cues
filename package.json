    "@playwright/test": "1.58.2",
    "@testing-library/svelte": "5.2.8",
    "@types/qrcode": "1.5.5",
    "jsdom": "26.1.0",
    "svelte": "5.56.10",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
